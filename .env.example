# Single env file for every local workflow in this repo. Copy to .env (which is
# gitignored) and fill in the values. CI never reads this file; it uses GitHub
# Actions repository secrets instead.
#
#   cp .env.example .env
#
# Consumers:
#   infra/fastly     npm run preview / up / refresh (dotenv -e ../../.env)
#   infra/honeycomb  npm run preview / up / refresh (dotenv -e ../../.env)
#   local/otel       docker compose --env-file ../../.env up -d

# Fastly API token with write access to the service.
# https://manage.fastly.com/account/personal/tokens
FASTLY_API_KEY=

# Honeycomb v2 Management Key pair for the Pulumi provider. Create under Team
# settings -> API Keys -> Management Keys, with scopes: environments:read,
# environments:write, api-keys:write.
HONEYCOMB_KEY_ID=
HONEYCOMB_KEY_SECRET=

# Collector config for the local RUM backend (local/otel):
#   collector-config.yaml            Jaeger only (default)
#   collector-config-honeycomb.yaml  Jaeger + forward to the tollmanz-com-local
#                                    Honeycomb environment
OTEL_COLLECTOR_CONFIG=collector-config.yaml

# Ingest key for the tollmanz-com-local Honeycomb environment, managed by
# infra/honeycomb. Only used by collector-config-honeycomb.yaml. Read it from
# the stack, never from the production key:
#   cd infra/honeycomb && pulumi stack output localIngestKey --show-secrets
HONEYCOMB_LOCAL_INGEST_KEY=

# v1 Configuration Keys for the infra/honeycomb board tier, one per environment,
# used when the matching manageProdBoard / manageLocalBoard stack config is true.
# Boards are v1 resources that the v2 Management Key cannot manage, and this plan
# blocks minting configuration keys via API, so create each by hand in the
# Honeycomb UI (Environment settings -> API Keys, Manage Queries and Columns +
# Manage Boards) in the matching environment and paste it here. See
# infra/honeycomb/README.md.
#   HONEYCOMB_CONFIG_KEY        tollmanz-com        (prod board)
#   HONEYCOMB_LOCAL_CONFIG_KEY  tollmanz-com-local  (local board)
HONEYCOMB_CONFIG_KEY=
HONEYCOMB_LOCAL_CONFIG_KEY=
