# Local secrets for `npm run preview` / `npm run up`. Never committed (.env is gitignored).
# In CI these come from GitHub Actions secrets instead.

# Honeycomb v2 Management Key pair. Create under Team settings -> API Keys ->
# Management Keys, with scopes: environments:read, environments:write,
# api-keys:write.
HONEYCOMB_KEY_ID=
HONEYCOMB_KEY_SECRET=
