{
  "name": "tollmanz-com-infra",
  "version": "1.0.0",
  "description": "Fastly CDN configuration for tollmanz.com, managed with Pulumi",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "preview": "dotenv -e ../../.env -- pulumi preview",
    "up": "dotenv -e ../../.env -- pulumi up",
    "refresh": "dotenv -e ../../.env -- pulumi refresh",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@pulumi/command": "1.2.1",
    "@pulumi/fastly": "12.2.1",
    "@pulumi/pulumi": "3.246.0"
  },
  "devDependencies": {
    "@types/node": "25.9.3",
    "dotenv-cli": "11.0.0",
    "prettier": "3.6.2",
    "ts-node": "10.9.2",
    "typescript": "6.0.3"
  },
  "overrides": {
    "js-yaml": "4.2.0"
  }
}
