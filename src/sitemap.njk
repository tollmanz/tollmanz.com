---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>{{ "/" | absoluteUrl(site.url) }}</loc>
    <lastmod>{{ collections.posts[0].date | dateToRfc3339 }}</lastmod>
    <changefreq>weekly</changefreq>
    <priority>1.0</priority>
  </url>
{%- for post in collections.posts %}
  <url>
    <loc>{{ post.url | absoluteUrl(site.url) }}</loc>
    <lastmod>{{ post.date | dateToRfc3339 }}</lastmod>
    <changefreq>monthly</changefreq>
    <priority>0.8</priority>
  </url>
{%- endfor %}
{%- for page in collections.pages %}
  <url>
    <loc>{{ page.url | absoluteUrl(site.url) }}</loc>
    <lastmod>{{ page.date | dateToRfc3339 }}</lastmod>
    <changefreq>monthly</changefreq>
    <priority>0.6</priority>
  </url>
{%- endfor %}
{#- /speaking/ is a standalone template, so it belongs to neither collection
    and has to be listed on its own. Its lastmod follows the same rule as the
    talk pages below: only an explicit `updated` date counts. -#}
  <url>
    <loc>{{ "/speaking/" | absoluteUrl(site.url) }}</loc>
    <changefreq>monthly</changefreq>
    <priority>0.6</priority>
  </url>
{#- Talk pages describe past engagements but were authored much later, so the
    engagement date says nothing about when the page last changed. Emit lastmod
    only when a talk records an explicit `updated` date. -#}
{%- for talk in collections.talks %}
  <url>
    <loc>{{ talk.url | absoluteUrl(site.url) }}</loc>
{%- if talk.data.updated %}
    <lastmod>{{ talk.data.updated | dateToRfc3339 }}</lastmod>
{%- endif %}
    <changefreq>yearly</changefreq>
    <priority>0.5</priority>
  </url>
{%- endfor %}
</urlset>
