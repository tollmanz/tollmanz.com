---
layout: base.njk
---
{#- All fields are optional: each section renders only when its data exists,
    so a sparse talk omits empties while a fully described one shows everything. -#}
{%- set self = { title: title, description: description } -%}
{%- set ttype = title | talkType -%}
{%- set topics = self | talkTopics -%}
{%- set primary = topics[0].slug if topics.length else "talk" -%}
{%- set links = sources | categorizeSources -%}
{%- set slidesIsPdf = slides | isLocalPdf -%}
{%- set paras = description | paragraphs -%}
{%- set body = content | trim -%}
{%- set related = collections.talks | relatedTalks(page.inputPath) -%}

<article class="talk-page t-{{ primary }}">
  <header class="talk-page__header">
    <p class="talk-page__eyebrow"><a href="/speaking/">Speaking</a></p>
    {% if ttype.slug != "talk" %}<span class="talk-badge talk-badge--{{ ttype.slug }}">{{ ttype.label }}</span>{% endif %}
    <h1 class="talk-page__title">{{ title | displayTitle }}</h1>

    <dl class="talk-page__meta">
      <div class="talk-page__meta-item">
        <dt>When</dt>
        <dd><time datetime="{{ date | htmlDateString }}">{{ date | dateDisplay }}</time></dd>
      </div>
      {% if conference or location %}
        <div class="talk-page__meta-item">
          <dt>Where</dt>
          <dd>{{ conference }}{% if conference and location %} &middot; {% endif %}{{ location }}</dd>
        </div>
      {% endif %}
      {% if coSpeakers %}
        <div class="talk-page__meta-item">
          <dt>With</dt>
          <dd>{{ coSpeakers }}</dd>
        </div>
      {% endif %}
      {% if audienceSize %}
        <div class="talk-page__meta-item">
          <dt>Audience</dt>
          <dd>{{ audienceSize }}</dd>
        </div>
      {% endif %}
    </dl>

    {% if topics.length %}
      <ul class="talk-topics">
        {% for top in topics %}<li class="talk-topic t-{{ top.slug }}">{{ top.label }}</li>{% endfor %}
      </ul>
    {% endif %}
  </header>

  {% if links.code.length %}
    <div class="talk-actions">
      {% for repo in links.code %}<a class="talk-action" href="{{ repo.url }}">{{ repo.label }}</a>{% endfor %}
    </div>
  {% endif %}

  {% if paras.length %}
    <section class="talk-section">
      <h2 class="talk-section__title">Abstract</h2>
      <div class="talk-prose">
        {% for p in paras %}<p>{{ p }}</p>{% endfor %}
      </div>
    </section>
  {% endif %}

  {% if body %}
    <section class="talk-section">
      <h2 class="talk-section__title">Notes</h2>
      <div class="talk-prose">{{ content | safe }}</div>
    </section>
  {% endif %}

  {% if takeaways and takeaways.length %}
    <section class="talk-section">
      <h2 class="talk-section__title">Key takeaways</h2>
      <ul class="talk-takeaways">
        {% for item in takeaways %}<li>{{ item }}</li>{% endfor %}
      </ul>
    </section>
  {% endif %}

  {% if quotes and quotes.length %}
    <section class="talk-section">
      <h2 class="talk-section__title">From the audience</h2>
      {% for q in quotes %}
        <blockquote class="talk-quote">
          <p>{{ q.text }}</p>
          {% if q.author %}<cite>{% if q.url %}<a href="{{ q.url }}">{{ q.author }}</a>{% else %}{{ q.author }}{% endif %}</cite>{% endif %}
        </blockquote>
      {% endfor %}
    </section>
  {% endif %}

  {% if photos and photos.length %}
    <section class="talk-section">
      <h2 class="talk-section__title">Photos</h2>
      <div class="talk-gallery">
        {% for photo in photos %}
          <figure>
            <img src="{{ photo.src }}" alt="{{ photo.alt or title }}" />
            {% if photo.credit %}<figcaption>{{ photo.credit }}</figcaption>{% endif %}
          </figure>
        {% endfor %}
      </div>
    </section>
  {% endif %}

  {% if video or slides or links.reading.length or links.elsewhere.length or (press and press.length) or (resources and resources.length) %}
    <section class="talk-section">
      <h2 class="talk-section__title">Links &amp; resources</h2>
      <ul class="talk-resources">
        {% if video %}<li><a href="{{ video }}">Video</a> <span class="talk-resource__tag">{{ video | videoProvider }}{% if watchTime or duration %} &middot; {{ watchTime or duration }}{% endif %}</span></li>{% endif %}
        {% if slides %}
          {% if slidesIsPdf %}
            <li><a href="{{ slides }}" download>Slides (PDF)</a>{% if slideCount %} <span class="talk-resource__tag">{{ slideCount }} slides</span>{% endif %}</li>
          {% else %}
            <li><a href="{{ slides }}">Slides</a> <span class="talk-resource__tag">{{ slides | slidesProvider }}{% if slideCount %} &middot; {{ slideCount }} slides{% endif %}</span></li>
          {% endif %}
        {% endif %}
        {% for r in resources %}<li><a href="{{ r.url }}"{% if r.download %} download{% endif %}>{{ r.label }}</a></li>{% endfor %}
        {% for r in links.reading %}<li><a href="{{ r.url }}">{{ r.label }}</a> <span class="talk-resource__tag">on this site</span></li>{% endfor %}
        {% for r in links.elsewhere %}<li><a href="{{ r.url }}">{{ r.label }}</a></li>{% endfor %}
        {% for p in press %}<li><a href="{{ p.url }}">{{ p.label }}</a>{% if p.outlet %} <span class="talk-resource__tag">{{ p.outlet }}</span>{% endif %}</li>{% endfor %}
      </ul>
    </section>
  {% endif %}

  {% if transcript %}
    <section class="talk-section">
      <h2 class="talk-section__title">Transcript</h2>
      <div class="talk-prose">{{ transcript | safe }}</div>
    </section>
  {% endif %}

  {% if related.length %}
    <section class="talk-section talk-related">
      <h2 class="talk-section__title">Related talks</h2>
      <ul class="talk-related__list">
        {% for r in related %}
          {%- set rself = { title: r.data.title, description: r.data.description } -%}
          {%- set rtopics = rself | talkTopics -%}
          {%- set rprimary = rtopics[0].slug if rtopics.length else "talk" -%}
          <li class="talk-related__item t-{{ rprimary }}">
            <a href="{{ r.url }}">
              <span class="talk-related__date">{{ r.date | dateDisplay }}</span>
              <span class="talk-related__main">
                <span class="talk-related__title">{{ r.data.title | displayTitle }}</span>
                {% if r.data.conference %}<span class="talk-related__conf">{{ r.data.conference }}</span>{% endif %}
              </span>
            </a>
          </li>
        {% endfor %}
      </ul>
    </section>
  {% endif %}

  <p class="talk-page__back"><a href="/speaking/">&larr; All talks</a></p>
</article>
