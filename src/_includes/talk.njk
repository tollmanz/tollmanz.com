---
layout: base.njk
---
{#- Talks state their own type, topics, series, and link kinds in front matter
    (see docs/talks.md). Everything optional renders only when present, so a
    sparse talk omits empties while a fully described one shows everything. -#}
{%- set ttype = type | talkType -%}
{%- set topicList = topics | talkTopics -%}
{%- set primary = topicList[0].slug if topicList.length else "talk" -%}
{%- set links = sources | sourceGroups -%}
{%- set paras = description | paragraphs -%}
{%- set body = content | trim -%}
{%- set related = collections.talks | relatedTalks(page.inputPath) -%}

<article class="talk-page t-{{ primary }}">
  <header class="talk-page__header">
    <p class="talk-page__eyebrow"><a href="/speaking/">Speaking</a></p>
    {% if ttype.slug != "talk" %}<span class="talk-badge talk-badge--{{ ttype.slug }}">{{ ttype.label }}</span>{% endif %}
    <h1 class="talk-page__title">{{ title }}</h1>

    <dl class="talk-page__meta">
      <div class="talk-page__meta-item">
        <dt>When</dt>
        <dd><time datetime="{{ date | htmlDateString(datePrecision) }}">{{ date | dateDisplay(datePrecision) }}</time></dd>
      </div>
      {% if event.name or event.location %}
        <div class="talk-page__meta-item">
          <dt>Where</dt>
          <dd>{{ event.name }}{% if event.name and event.location %} &middot; {% endif %}{{ event.location }}</dd>
        </div>
      {% endif %}
      {% if coSpeakers %}
        <div class="talk-page__meta-item">
          <dt>With</dt>
          <dd>{{ coSpeakers }}</dd>
        </div>
      {% endif %}
    </dl>

    {% if topicList.length %}
      <ul class="talk-topics">
        {% for top in topicList %}<li class="talk-topic t-{{ top.slug }}">{{ top.label }}</li>{% endfor %}
      </ul>
    {% endif %}
  </header>

  {#- The recording and the deck are what most visitors came for, so they lead
      the page instead of sitting at the bottom of "Links & resources". Each
      button carries the provider and the size of the artifact, so the link
      says where it goes and what it costs before it is clicked. -#}
  {% if video.url or slides.url or links.code.length %}
    <div class="talk-actions">
      {% if video.url %}
        <a class="talk-action talk-action--primary" href="{{ video.url }}">Watch the talk{% if video.provider or video.duration %} <span class="talk-action__meta">{{ video.provider }}{% if video.provider and video.duration %} &middot; {% endif %}{{ video.duration }}</span>{% endif %}</a>
      {% endif %}
      {% if slides.url %}
        <a class="talk-action" href="{{ slides.url }}"{% if slides.download %} download{% endif %}>{% if slides.download %}Download the slides{% else %}View the slides{% endif %}{% if slides.provider or slides.count %} <span class="talk-action__meta">{{ slides.provider }}{% if slides.provider and slides.count %} &middot; {% endif %}{% if slides.count %}{{ slides.count }} slides{% endif %}</span>{% endif %}</a>
      {% endif %}
      {% for repo in links.code %}<a class="talk-action" href="{{ repo.url }}">{{ repo | sourceLabel }}</a>{% endfor %}
    </div>
  {% endif %}

  {% if paras.length %}
    <section class="talk-section">
      <h2 class="talk-section__title">Abstract</h2>
      <div class="talk-prose">
        {% for p in paras %}<p>{{ p }}</p>{% endfor %}
      </div>
    </section>
  {% endif %}

  {% if body %}
    <section class="talk-section">
      <h2 class="talk-section__title">Notes</h2>
      <div class="talk-prose">{{ content | safe }}</div>
    </section>
  {% endif %}

  {% if takeaways and takeaways.length %}
    <section class="talk-section">
      <h2 class="talk-section__title">Key takeaways</h2>
      <ul class="talk-takeaways">
        {% for item in takeaways %}<li>{{ item }}</li>{% endfor %}
      </ul>
    </section>
  {% endif %}

  {% if photos and photos.length %}
    <section class="talk-section">
      <h2 class="talk-section__title">Photos</h2>
      <div class="talk-gallery">
        {% for photo in photos %}
          <figure>
            <img src="{{ photo.src }}" alt="{{ photo.alt or title }}" />
            {% if photo.credit %}<figcaption>{{ photo.credit }}</figcaption>{% endif %}
          </figure>
        {% endfor %}
      </div>
    </section>
  {% endif %}

  {#- Secondary material only: the video and the deck render in the action row
      above, so nothing here repeats them. -#}
  {% if links.session.length or links.writing.length or links.coverage.length %}
    <section class="talk-section">
      <h2 class="talk-section__title">Links &amp; resources</h2>
      <ul class="talk-resources">
        {#- Anchors carry "Publisher: title" and nothing else. Editorial detail
            about what a link contains lives in `note` and renders under it. -#}
        {% for r in links.session %}<li><a href="{{ r.url }}">{{ r | sourceLabel }}</a>{% if r.duration %} <span class="talk-resource__tag">{{ r.duration }}</span>{% endif %}{% if r.note %}<span class="talk-resource__note">{{ r.note }}</span>{% endif %}</li>{% endfor %}
        {% for r in links.writing %}<li><a href="{{ r.url }}">{{ r | sourceLabel }}</a> <span class="talk-resource__tag">on this site</span>{% if r.note %}<span class="talk-resource__note">{{ r.note }}</span>{% endif %}</li>{% endfor %}
        {% for r in links.coverage %}<li><a href="{{ r.url }}">{{ r | sourceLabel }}</a>{% if r.duration %} <span class="talk-resource__tag">{{ r.duration }}</span>{% endif %}{% if r.note %}<span class="talk-resource__note">{{ r.note }}</span>{% endif %}</li>{% endfor %}
      </ul>
    </section>
  {% endif %}

  {% if transcript %}
    <section class="talk-section">
      <h2 class="talk-section__title">Transcript</h2>
      <div class="talk-prose">{{ transcript | safe }}</div>
    </section>
  {% endif %}

  {% if related.length %}
    <section class="talk-section talk-related">
      <h2 class="talk-section__title">Related talks</h2>
      <ul class="talk-related__list">
        {% for r in related %}
          {%- set rtopics = r.data.topics | talkTopics -%}
          {%- set rprimary = rtopics[0].slug if rtopics.length else "talk" -%}
          <li class="talk-related__item t-{{ rprimary }}">
            <a href="{{ r.url }}">
              <span class="talk-related__date">{{ r.date | dateDisplay(r.data.datePrecision) }}</span>
              <span class="talk-related__main">
                <span class="talk-related__title">{{ r.data.title }}</span>
                {% if r.data.event.name %}<span class="talk-related__conf">{{ r.data.event.name }}</span>{% endif %}
              </span>
            </a>
          </li>
        {% endfor %}
      </ul>
    </section>
  {% endif %}

  <p class="talk-page__back"><a href="/speaking/">&larr; All talks</a></p>
</article>
