---
layout: base.njk
title: Speaking
permalink: /speaking/
description: Conference talks and speaking engagements by Zack Tollman, with links to slides and video where available.
---

<div class="speaking">
  <header class="post-header">
    <h1 class="post-title">Speaking</h1>
  </header>

  <p class="speaking-intro">
    A running index of conference talks and other speaking engagements.
  </p>

  {% set facets = collections.talks | eventFacets %}

  {# Zero-JS filtering: checkboxes/radios drive :has() rules generated below.
     Format checkboxes combine (AND); the Event radios are single-select. #}
  <style>
    .speaking:has(#flt-video:checked) .talk:not(.has-video) { display: none; }
    .speaking:has(#flt-slides:checked) .talk:not(.has-slides) { display: none; }
    {%- for f in facets %}
    .speaking:has(#evt-{{ f.slug }}:checked) .talk:not(.evt-{{ f.slug }}) { display: none; }
    {%- endfor %}
  </style>

  <div class="talk-filters">
    <fieldset class="talk-filters__group">
      <legend class="talk-filters__legend">Format</legend>
      <div class="talk-filters__chips">
        <input class="visually-hidden talk-filter" type="checkbox" id="flt-video" />
        <label class="talk-chip" for="flt-video">Video</label>
        <input class="visually-hidden talk-filter" type="checkbox" id="flt-slides" />
        <label class="talk-chip" for="flt-slides">Slides</label>
      </div>
    </fieldset>
    <fieldset class="talk-filters__group">
      <legend class="talk-filters__legend">Event</legend>
      <div class="talk-filters__chips">
        <input class="visually-hidden talk-filter" type="radio" name="evt" id="evt-all" checked />
        <label class="talk-chip" for="evt-all">All</label>
        {% for f in facets %}
          <input class="visually-hidden talk-filter" type="radio" name="evt" id="evt-{{ f.slug }}" />
          <label class="talk-chip" for="evt-{{ f.slug }}">{{ f.label }} <span class="talk-chip__count">{{ f.count }}</span></label>
        {% endfor %}
      </div>
    </fieldset>
  </div>

  <ul class="talk-list">
    {% for talk in collections.talks %}
      <li class="talk evt-{{ talk.data.eventType or 'other' }}{% if talk.data.video %} has-video{% endif %}{% if talk.data.slides %} has-slides{% endif %}">
        <p class="talk-meta">
          {% if talk.data.dateText %}
            <span class="talk-date">{{ talk.data.dateText }}</span>
          {% else %}
            <time class="talk-date" datetime="{{ talk.date | htmlDateString }}">{{ talk.date | dateDisplay }}</time>
          {% endif %}
          {% if talk.data.conference %}<span class="talk-conference">{{ talk.data.conference }}</span>{% endif %}
          {% if talk.data.location %}<span class="talk-location">{{ talk.data.location }}</span>{% endif %}
        </p>
        <h2 class="talk-title">{{ talk.data.title }}</h2>
        {% if talk.data.coSpeakers %}
          <p class="talk-cospeakers">with {{ talk.data.coSpeakers }}</p>
        {% endif %}
        {% set paras = talk.data.description | paragraphs %}
        {% if paras.length %}
          <div class="talk-description">
            {% for para in paras %}<p>{{ para }}</p>{% endfor %}
          </div>
        {% endif %}
        <p class="talk-links">
          {% if talk.data.video %}<a href="{{ talk.data.video }}">Video</a>{% endif %}
          {% if talk.data.slides %}<a href="{{ talk.data.slides }}">Slides</a>{% endif %}
          {% for source in talk.data.sources %}<a href="{{ source.url }}">{{ source.label }}</a>{% endfor %}
        </p>
      </li>
    {% endfor %}
  </ul>
</div>
