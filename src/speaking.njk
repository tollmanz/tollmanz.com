---
layout: base.njk
title: Speaking
permalink: /speaking/
description: Conference talks, keynotes, and meetups by Zack Tollman, with links to slides, video, and individual talk pages.
---

{%- set stats = collections.talks | speakingStats -%}
{%- set topFacets = collections.talks | topicFacets -%}
{%- set evtFacets = collections.talks | eventFacets -%}
{%- set evtFacetOf = collections.talks | eventFacetSlug -%}
{%- set featured = collections.talks | featuredTalks -%}

<div class="speaking">
  <header class="speaking-hero">
    <h1 class="speaking-hero__title">Speaking</h1>
    <p class="speaking-hero__lede">
      Conference talks, keynotes, and meetups, mostly about making the web faster and harder to break.
    </p>
    <dl class="speaking-stats">
      <div class="speaking-stat">
        <dt>Talks</dt>
        <dd>{{ stats.count }}</dd>
      </div>
      {% if stats.firstYear %}
        <div class="speaking-stat">
          <dt>Years</dt>
          <dd>{{ stats.firstYear }}&ndash;{{ stats.lastYear }}</dd>
        </div>
      {% endif %}
      <div class="speaking-stat">
        <dt>On video</dt>
        <dd>{{ stats.withVideo }}</dd>
      </div>
      <div class="speaking-stat">
        <dt>With slides</dt>
        <dd>{{ stats.withSlides }}</dd>
      </div>
    </dl>
  </header>

  {#- Featured tier: an editorial shortlist, capped by featuredTalks rather than
      by the front matter that opts talks in. Every talk here also appears in
      the chronological list below. The section hides whenever a narrowing
      filter is checked (see .talk-filter--narrow in main.css), so the cards are
      never a stale subset of a filtered list. -#}
  {% if featured.length %}
    <section class="talk-featured" aria-labelledby="talk-featured-title">
      <h2 class="talk-featured__title" id="talk-featured-title">Start here</h2>
      <ul class="talk-featured__list">
        {% for talk in featured %}
          {%- set topics = talk.data.topics | talkTopics -%}
          {%- set primary = topics[0].slug if topics.length else "talk" -%}
          {%- set photo = talk.data.photos[0] if talk.data.photos.length -%}
          {%- set hook = talk.data | talkHook -%}
          <li class="talk-card t-{{ primary }}">
            {%- if photo %}
              {#- Card-sized derivatives: the transform plugin's page defaults
                  are sized for a full-width figure, which a card never is. The
                  tier renders in the first viewport, so these load eagerly
                  rather than under the plugin's lazy default. -#}
              <img class="talk-card__img" src="{{ photo.src }}" alt="{{ photo.alt or talk.data.title }}" loading="eager" eleventy:widths="250,500,780" eleventy:sizes="(max-width: 640px) calc(100vw - 30px), 244px" />
            {% endif -%}
            <div class="talk-card__body">
              <h3 class="talk-card__title">
                <a class="talk-card__link" href="{{ talk.url }}">{{ talk.data.title }}</a>
              </h3>
              <p class="talk-card__meta">
                {{ talk.data.event.name }}{% if talk.date %} &middot; {{ talk.date | year }}{% endif %}
              </p>
              {%- if hook %}
                {% if hook.quote %}
                  <blockquote class="talk-card__hook">
                    <p>{{ hook.text }}</p>
                    {% if hook.cite %}<cite>{{ hook.cite }}</cite>{% endif %}
                  </blockquote>
                {% else %}
                  <p class="talk-card__hook">{{ hook.text }}</p>
                {% endif %}
              {% endif -%}
              {% if talk.data.video.url or talk.data.slides.url %}
                <p class="talk-card__links">
                  {% if talk.data.video.url %}<a class="talk-card__fmt" href="{{ talk.data.video.url }}" aria-label="Video: {{ talk.data.title }}">Video</a>{% endif %}
                  {% if talk.data.slides.url %}<a class="talk-card__fmt" href="{{ talk.data.slides.url }}" aria-label="Slides: {{ talk.data.title }}">Slides</a>{% endif %}
                </p>
              {% endif %}
            </div>
          </li>
        {% endfor %}
      </ul>
    </section>
  {% endif %}

  {# Every filter state a year group has to answer for, as two CSS fragments:
     `has` detects the state from the inputs, `row` is the compound a row must
     carry to survive it. The Topic and Event lists lead with an empty entry
     standing for their "All" option; the format checkboxes are independent, so
     all four of their combinations appear. #}
  {%- set fmtStates = [
    { has: "", row: "" },
    { has: ":has(#flt-video:checked)", row: ".has-video" },
    { has: ":has(#flt-slides:checked)", row: ".has-slides" },
    { has: ":has(#flt-video:checked):has(#flt-slides:checked)", row: ".has-video.has-slides" }
  ] -%}
  {%- set topStates = [{ has: "", row: "" }] -%}
  {%- for f in topFacets -%}
    {%- set _ = topStates.push({ has: ":has(#top-" + f.slug + ":checked)", row: ".topic-" + f.slug }) -%}
  {%- endfor -%}
  {%- set evtStates = [{ has: "", row: "" }] -%}
  {%- for f in evtFacets -%}
    {%- set _ = evtStates.push({ has: ":has(#evt-" + f.slug + ":checked)", row: ".evt-" + f.slug }) -%}
  {%- endfor -%}
  {%- set groupSelectors = [] -%}
  {%- for fmt in fmtStates -%}{%- for top in topStates -%}{%- for evt in evtStates -%}
    {%- if fmt.row or top.row or evt.row -%}
      {%- set _ = groupSelectors.push(".speaking" + fmt.has + top.has + evt.has + " .talk-year-group:not(:has(" + top.row + evt.row + fmt.row + "))") -%}
    {%- endif -%}
  {%- endfor -%}{%- endfor -%}{%- endfor -%}

  {# Zero-JS filtering: the checkboxes/radios below drive these :has() rules.
     Format checkboxes combine (AND); the Topic and Event radios are single-select.
     The first block hides rows the active facets exclude, one rule per facet.
     The second hides year groups left with no matching row, which needs one
     selector per combination of active facets: whether a group still has a row
     is a question about all of them at once, so the row rules' AND-by-cascade
     does not carry over. #}
  <style>
    .speaking:has(#flt-video:checked) .talk-row:not(.has-video) { display: none; }
    .speaking:has(#flt-slides:checked) .talk-row:not(.has-slides) { display: none; }
    {%- for f in topFacets %}
    .speaking:has(#top-{{ f.slug }}:checked) .talk-row:not(.topic-{{ f.slug }}) { display: none; }
    {%- endfor %}
    {%- for f in evtFacets %}
    .speaking:has(#evt-{{ f.slug }}:checked) .talk-row:not(.evt-{{ f.slug }}) { display: none; }
    {%- endfor %}
    {{ groupSelectors | join(",") }} { display: none; }
  </style>

  <div class="talk-filters">
    <fieldset class="talk-filters__group">
      <legend class="talk-filters__legend">Format</legend>
      {#- `talk-filter` earns a chip its active underline and belongs on every
          control, including the All radios. `talk-filter--narrow` marks the
          controls that actually narrow the index, which is what hides the
          featured tier; the All radios are checked by default and narrow
          nothing, so they carry only the first class. -#}
      <div class="talk-filters__chips">
        <input class="visually-hidden talk-filter talk-filter--narrow" type="checkbox" id="flt-video" />
        <label class="talk-chip" for="flt-video">Video</label>
        <input class="visually-hidden talk-filter talk-filter--narrow" type="checkbox" id="flt-slides" />
        <label class="talk-chip" for="flt-slides">Slides</label>
      </div>
    </fieldset>
    <fieldset class="talk-filters__group">
      <legend class="talk-filters__legend">Topic</legend>
      <div class="talk-filters__chips">
        <input class="visually-hidden talk-filter" type="radio" name="top" id="top-all" checked />
        <label class="talk-chip" for="top-all">All</label>
        {% for f in topFacets %}
          <input class="visually-hidden talk-filter talk-filter--narrow" type="radio" name="top" id="top-{{ f.slug }}" />
          <label class="talk-chip talk-chip--topic t-{{ f.slug }}" for="top-{{ f.slug }}">{{ f.label }} <span class="talk-chip__count">{{ f.count }}</span></label>
        {% endfor %}
      </div>
    </fieldset>
    <fieldset class="talk-filters__group">
      <legend class="talk-filters__legend">Event</legend>
      <div class="talk-filters__chips">
        <input class="visually-hidden talk-filter" type="radio" name="evt" id="evt-all" checked />
        <label class="talk-chip" for="evt-all">All</label>
        {% for f in evtFacets %}
          <input class="visually-hidden talk-filter talk-filter--narrow" type="radio" name="evt" id="evt-{{ f.slug }}" />
          <label class="talk-chip" for="evt-{{ f.slug }}">{{ f.label }} <span class="talk-chip__count">{{ f.count }}</span></label>
        {% endfor %}
      </div>
    </fieldset>
  </div>

  {% for group in collections.talks | talksByYear %}
    <section class="talk-year-group">
      {% if group.year %}<h2 class="talk-year">{{ group.year }}</h2>{% endif %}
      <ul class="talk-index">
        {% for talk in group.talks %}
          {%- set ttype = talk.data.type | talkType -%}
          {%- set topics = talk.data.topics | talkTopics -%}
          {%- set primary = topics[0].slug if topics.length else "talk" -%}
          {%- set topicClasses %}{% for top in topics %} topic-{{ top.slug }}{% endfor %}{% endset -%}
          {%- set evtSlug = evtFacetOf[talk.data.event.type or "other"] or "other" -%}
          <li class="talk-row t-{{ primary }} evt-{{ evtSlug }} type-{{ ttype.slug }}{{ topicClasses }}{% if talk.data.video.url %} has-video{% endif %}{% if talk.data.slides.url %} has-slides{% endif %}">
            <div class="talk-row__when">
              {%- set shortDate = talk.date | monthDay(talk.data.datePrecision) -%}
              {% if shortDate %}<time class="talk-row__date" datetime="{{ talk.date | htmlDateString(talk.data.datePrecision) }}">{{ shortDate }}</time>{% endif %}
            </div>
            <div class="talk-row__body">
              {% if ttype.slug != "talk" %}<p class="talk-row__kind">{{ ttype.label }}</p>{% endif %}
              <h3 class="talk-row__title">
                <a class="talk-row__link" href="{{ talk.url }}">{{ talk.data.title }}</a>
              </h3>
              <p class="talk-row__meta">
                {% if talk.data.event.name %}{{ talk.data.event.name }}{% endif %}
                {%- if talk.data.event.location %} &middot; {{ talk.data.event.location }}{% endif %}
                {%- if talk.data.coSpeakers %} &middot; with {{ talk.data.coSpeakers }}{% endif %}
              </p>
              {% if topics.length or talk.data.video.url or talk.data.slides.url %}
                <p class="talk-row__tags">
                  {% for top in topics %}<span class="talk-row__topic t-{{ top.slug }}">{{ top.label }}</span>{% endfor %}
                  {% if talk.data.video.url %}<a class="talk-row__fmt" href="{{ talk.data.video.url }}" aria-label="Video: {{ talk.data.title }}">Video</a>{% endif %}
                  {% if talk.data.slides.url %}<a class="talk-row__fmt" href="{{ talk.data.slides.url }}" aria-label="Slides: {{ talk.data.title }}">Slides</a>{% endif %}
                </p>
              {% endif %}
            </div>
          </li>
        {% endfor %}
      </ul>
    </section>
  {% endfor %}
</div>
