# Copy to .env (gitignored) to forward local RUM to a Honeycomb "local"
# environment in addition to Jaeger. Leave this unset for the default
# Jaeger-only setup.

# Use the Honeycomb-enabled collector config.
OTEL_COLLECTOR_CONFIG=collector-config-honeycomb.yaml

# Ingest key for a SEPARATE Honeycomb environment used only for local testing.
# Create the environment and its ingest key in the Honeycomb UI (see README).
# Do NOT reuse the production ingest key; a separate environment is what keeps
# local data out of prod.
HONEYCOMB_LOCAL_INGEST_KEY=
