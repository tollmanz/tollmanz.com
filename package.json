{
  "name": "tollmanz.com",
  "version": "1.0.0",
  "description": "Personal website (www.tollmanz.com) built with Eleventy and deployed to GitHub Pages.",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "eleventy",
    "dev": "eleventy --serve",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "author": "Zack Tollman <tollmanz@gmail.com>",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@11ty/eleventy": "3.1.6",
    "@11ty/eleventy-plugin-rss": "3.0.0",
    "@11ty/eleventy-plugin-syntaxhighlight": "5.0.2",
    "clean-css": "5.3.3",
    "html-minifier-terser": "7.2.0",
    "luxon": "3.7.2",
    "markdown-it": "14.2.0",
    "prettier": "3.6.2"
  },
  "overrides": {
    "js-yaml": "4.2.0"
  }
}
